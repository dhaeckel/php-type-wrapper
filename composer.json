{
    "name": "haeckel/type_wrapper",
    "description": "Simple Library, that provides wrappers around scalar types and arrays. They are inspired by the builtin phpDoc-Types of phpstan, bringing static analysis of phpstan and runtime safety in one.",
    "type": "library",
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "license": "LGPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "Haeckel\\TypeWrapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Haeckel\\TypeWrapper\\Test\\": "test/"
        }
    },
    "authors": [
        {
            "name": "Dominik Häckel"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "scripts": {
        "test": [
            "@putenv XDEBUG_MODE=coverage",
            "vendor/bin/phpunit"
        ],
         "testSilent": [
            "@putenv XDEBUG_MODE=coverage",
            "vendor/bin/phpunit --no-output 2> /dev/null"
        ],
        "phpstan": [
            "vendor/bin/phpstan"
        ],
        "cs": [
            "vendor/bin/phpcs src/"
        ],
        "cbf": [
            "vendor/bin/phpcbf src/"
        ],
        "ci": [
            "@cbf -q",
            "@cs -q",
            "@phpstan -q",
            "@test --no-output"
        ],
        "local-ci": [
            "@cbf",
            "@cs",
            "@phpstan --no-progress",
            "@test --coverage-html .phpunit/html-coverage"
        ]
    },
     "archive": {
        "exclude": [
            "/test/",
            "phpcs.xml.dist",
            "phpstan.dist.neon",
            "phpunit.xml",
            ".gitignore",
            ".githooks",
            ".github"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
